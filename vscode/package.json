{
  "name": "ccprof-vscode",
  "displayName": "ccprof — Claude Code Profiles",
  "description": "See and switch the Claude Code profile (Team, personal, Vertex AI, Bedrock, API key) of each workspace, powered by the ccprof CLI. Unofficial.",
  "version": "0.5.0",
  "publisher": "francescoboschi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancescoBoschi/claude-code-profiles.git"
  },
  "homepage": "https://github.com/FrancescoBoschi/claude-code-profiles#readme",
  "bugs": {
    "url": "https://github.com/FrancescoBoschi/claude-code-profiles/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "vertex ai",
    "accounts",
    "profiles"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ccprof.menu",
        "title": "Menu",
        "category": "ccprof"
      },
      {
        "command": "ccprof.bind",
        "title": "Bind Profile to Workspace",
        "category": "ccprof"
      },
      {
        "command": "ccprof.unbind",
        "title": "Remove Binding",
        "category": "ccprof"
      },
      {
        "command": "ccprof.openTerminal",
        "title": "Open Claude Terminal with Profile…",
        "category": "ccprof"
      },
      {
        "command": "ccprof.list",
        "title": "Show Profiles and Projects",
        "category": "ccprof"
      },
      {
        "command": "ccprof.doctor",
        "title": "Doctor",
        "category": "ccprof"
      },
      {
        "command": "ccprof.configurePanel",
        "title": "Configure Claude Code Panel",
        "category": "ccprof"
      },
      {
        "command": "ccprof.refresh",
        "title": "Refresh Status",
        "category": "ccprof"
      }
    ],
    "configuration": {
      "title": "ccprof",
      "properties": {
        "ccprof.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ccprof` executable. Empty = `~/.local/share/ccprof/bin/ccprof`, otherwise `ccprof` from PATH."
        },
        "ccprof.highlightPersonal": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the status bar when the workspace uses a personal profile."
        },
        "ccprof.checkClaudeWrapper": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "On startup, check that `claudeCode.claudeProcessWrapper` points to the ccprof shim."
        }
      }
    }
  }
}
