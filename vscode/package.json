{
  "name": "ccm-vscode",
  "displayName": "ccm — Claude Code Manager",
  "description": "See and switch the Claude Code profile (Team, personal, Vertex AI) of each workspace, powered by the ccm CLI. Unofficial.",
  "version": "0.3.0",
  "publisher": "francescoboschi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancescoBoschi/claude-code-profiles.git"
  },
  "homepage": "https://github.com/FrancescoBoschi/claude-code-profiles#readme",
  "bugs": {
    "url": "https://github.com/FrancescoBoschi/claude-code-profiles/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "vertex ai",
    "accounts",
    "profiles"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ccm.menu",
        "title": "Menu",
        "category": "ccm"
      },
      {
        "command": "ccm.bind",
        "title": "Bind Profile to Workspace",
        "category": "ccm"
      },
      {
        "command": "ccm.unbind",
        "title": "Remove Binding",
        "category": "ccm"
      },
      {
        "command": "ccm.openTerminal",
        "title": "Open Claude Terminal with Profile…",
        "category": "ccm"
      },
      {
        "command": "ccm.list",
        "title": "Show Profiles and Projects",
        "category": "ccm"
      },
      {
        "command": "ccm.doctor",
        "title": "Doctor",
        "category": "ccm"
      },
      {
        "command": "ccm.configurePanel",
        "title": "Configure Claude Code Panel",
        "category": "ccm"
      },
      {
        "command": "ccm.refresh",
        "title": "Refresh Status",
        "category": "ccm"
      }
    ],
    "configuration": {
      "title": "ccm",
      "properties": {
        "ccm.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ccm` executable. Empty = `~/.local/share/ccm/bin/ccm`, otherwise `ccm` from PATH."
        },
        "ccm.highlightPersonal": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the status bar when the workspace uses a personal profile."
        },
        "ccm.checkClaudeWrapper": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "On startup, check that `claudeCode.claudeProcessWrapper` points to the ccm shim."
        }
      }
    }
  }
}
