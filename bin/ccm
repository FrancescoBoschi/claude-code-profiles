#!/usr/bin/env bash
# ccm — Claude Code Manager: one Claude Code account per project, automatically.
set -euo pipefail
CCM_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
. "$CCM_ROOT/lib/ccm-common.sh"

usage() {
  cat <<EOF
ccm $CCM_VERSION — one Claude Code account per project

Usage: ccm <command> [arguments]

Profiles (create as many as you need, with any name you like)
  add <name> [--type team|personal|vertex] [--project ID] [--region R] [--gcloud-config NAME]
                        create a profile (asks for anything missing)
  login <name>          first login for a profile (OAuth, or gcloud credentials for vertex)
  rename <old> <new>    rename a profile and update its bindings
  edit <name>           open the profile file in \$EDITOR
  remove <name>         delete the profile and its bindings

Projects
  bind <profile> [dir]  bind a project (default: git root, or current directory)
  unbind [dir]          remove the binding
  which [dir] [--json]  show which profile would be used here, and why
  current [dir]         print just the profile name (for prompts and scripts)

Other
  list [--json]         profiles and bound projects
  run <profile> [args]  run claude with a forced profile, just this once
  doctor                check installation, PATH, logins and bindings
  init                  shell snippet for your rc file
  version

Examples
  ccm add work     --type team
  ccm add personal --type personal
  ccm add side     --type personal
  ccm add gcp-prod --type vertex --project my-billing-project
  cd ~/code/app && ccm bind work

Once a project is bound, just run "claude" as usual.
EOF
}

need_profile() {
  [ -n "${1:-}" ] || ccm_die "specify a profile"
  ccm_profile_exists "$1" || ccm_die "profile '$1' does not exist (profiles: $(ccm_profile_names | tr '\n' ' '))"
}

ask() { # prompt default -> prints the answer
  local ans=""
  if [ -t 0 ]; then
    printf '%s%s: ' "$1" "${2:+ [$2]}" >&2
    read -r ans || true
  fi
  printf '%s' "${ans:-${2:-}}"
}

# JSON string with escaping, or null when empty
jstr() {
  if [ -z "$1" ]; then printf 'null'; return; fi
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$(printf '\t')/\\\\t/g")"
}

cmd_add() {
  local name="${1:-}" type="" project="" region="" gcfg=""
  [ -n "$name" ] || ccm_die "usage: ccm add <name> [--type team|personal|vertex] ..."
  shift
  ccm_valid_name "$name" || ccm_die "invalid name: use letters, digits, '-' and '_'"
  ccm_profile_exists "$name" && ccm_die "profile '$name' already exists (edit it with: ccm edit $name)"
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || ccm_die "missing value for $1"
    case "$1" in
      --type) type="$2" ;;
      --project) project="$2" ;;
      --region) region="$2" ;;
      --gcloud-config) gcfg="$2" ;;
      *) ccm_die "unknown option: $1" ;;
    esac
    shift 2
  done

  [ -n "$type" ] || type="$(ask "Type (team / personal / vertex)" "")"
  case "$type" in team|personal|vertex) ;; *) ccm_die "invalid type: '$type' (use team, personal or vertex)" ;; esac

  if [ "$type" = vertex ]; then
    [ -n "$project" ] || project="$(ask "GCP project for billing" "")"
    [ -n "$project" ] || ccm_die "a vertex profile needs --project"
    [ -n "$region" ] || region="$(ask "Vertex region (CLOUD_ML_REGION)" "global")"
    [ -n "$gcfg" ] || gcfg="$(ask "gcloud configuration to use (empty = the active one)" "")"
  fi

  local dir="$CCM_ACCOUNTS_DIR/$name" f
  f="$(ccm_profile_file "$name")"
  mkdir -p "$CCM_PROFILES_DIR" "$dir"
  chmod 700 "$CCM_HOME" "$CCM_PROFILES_DIR" "$dir" 2>/dev/null || true
  {
    echo "# ccm profile: $name"
    printf 'CCM_KIND=%q\n' "$type"
    printf 'CLAUDE_CONFIG_DIR=%q\n' "$dir"
    if [ "$type" = vertex ]; then
      echo "CLAUDE_CODE_USE_VERTEX=1"
      printf 'CLOUD_ML_REGION=%q\n' "$region"
      printf 'ANTHROPIC_VERTEX_PROJECT_ID=%q\n' "$project"
      [ -z "$gcfg" ] || printf 'CLOUDSDK_ACTIVE_CONFIG_NAME=%q\n' "$gcfg"
    fi
  } > "$f"
  chmod 600 "$f"

  # Claude Code statusline showing the active profile (only if none exists yet).
  if [ ! -f "$dir/settings.json" ]; then
    cat > "$dir/settings.json" <<EOF
{
  "statusLine": {
    "type": "command",
    "command": "\"$CCM_ROOT/bin/ccm\" statusline"
  }
}
EOF
  fi

  echo "✓ profile '$name' ($type) created"
  echo "  config dir: $(ccm_tilde "$dir")"
  echo "  next steps:"
  echo "    ccm login $name"
  echo "    cd <project> && ccm bind $name"
}

cmd_login() {
  need_profile "${1:-}"
  local name="$1" kind real
  kind="$(ccm_profile_get "$name" CCM_KIND)"
  if [ "$kind" = vertex ]; then
    command -v gcloud >/dev/null || ccm_die "gcloud not found: install the Google Cloud SDK"
    ( ccm_load_profile "$name"; gcloud auth application-default login )
    echo "✓ ADC credentials refreshed for '$name'"
  else
    real="$(ccm_real_claude)" || ccm_die "real 'claude' binary not found on PATH"
    echo "Starting Claude Code with profile '$name'."
    echo "If the login screen does not appear, type /login. Type /exit when you are done."
    ( ccm_load_profile "$name"; exec "$real" )
  fi
}

cmd_rename() {
  local old="${1:-}" new="${2:-}" src dst
  if [ -z "$old" ] || [ -z "$new" ]; then ccm_die "usage: ccm rename <old> <new>"; fi
  need_profile "$old"
  ccm_valid_name "$new" || ccm_die "invalid name: use letters, digits, '-' and '_'"
  ccm_profile_exists "$new" && ccm_die "profile '$new' already exists"
  src="$(ccm_profile_file "$old")"; dst="$(ccm_profile_file "$new")"
  sed "1s/^# ccm profile: .*/# ccm profile: $new/" "$src" > "$dst"
  chmod 600 "$dst"
  rm -f "$src"
  if [ -f "$CCM_PROJECTS_FILE" ]; then
    O="$old" N="$new" awk -F'\t' -v OFS='\t' '!/^#/ && $2 == ENVIRON["O"] { $2 = ENVIRON["N"] } 1' \
      "$CCM_PROJECTS_FILE" > "$CCM_PROJECTS_FILE.tmp.$$"
    mv "$CCM_PROJECTS_FILE.tmp.$$" "$CCM_PROJECTS_FILE"
  fi
  echo "✓ profile '$old' renamed to '$new' (bindings updated)"
  echo "  config dir unchanged, so logins and conversations are kept: $(ccm_tilde "$(ccm_profile_get "$new" CLAUDE_CONFIG_DIR)")"
}

cmd_bind() {
  need_profile "${1:-}"
  local prof="$1" target
  if [ -n "${2:-}" ]; then
    target="$(ccm_realdir "$2")"; [ -n "$target" ] || ccm_die "no such directory: $2"
  else
    target="$(ccm_default_target)"
  fi
  mkdir -p "$CCM_HOME"; touch "$CCM_PROJECTS_FILE"
  ccm_projects_remove "$target"
  printf '%s\t%s\n' "$target" "$prof" >> "$CCM_PROJECTS_FILE"
  echo "✓ $(ccm_tilde "$target") → $prof"
}

cmd_unbind() {
  local target
  if [ -n "${1:-}" ]; then
    target="$(ccm_realdir "$1")"; [ -n "$target" ] || ccm_die "no such directory: $1"
  else
    target="$(ccm_default_target)"
  fi
  if [ -f "$CCM_PROJECTS_FILE" ] && cut -f1 "$CCM_PROJECTS_FILE" | grep -Fqx -- "$target"; then
    ccm_projects_remove "$target"
    echo "✓ removed the binding for $(ccm_tilde "$target")"
  else
    ccm_warn "no direct binding for $(ccm_tilde "$target") (see: ccm which)"
    return 1
  fi
}

cmd_which() {
  local a json=0 arg="" dir match="" prof via="" src="" bound="" kind="" cfg="" proj="" region="" root sf exists=1
  local warns=""
  for a in ${1+"$@"}; do
    case "$a" in --json) json=1 ;; *) arg="$a" ;; esac
  done
  dir="$(ccm_realdir "${arg:-.}")"; [ -n "$dir" ] || ccm_die "no such directory: ${arg:-.}"
  if [ -n "${CCM_OVERRIDE:-}" ]; then
    prof="$CCM_OVERRIDE"; src=override; via="forced by CCM_OVERRIDE"
  else
    match="$(ccm_resolve "$dir")"
    prof="${match%%"$CCM_TAB"*}"
    if [ -n "$prof" ]; then src=bind; bound="${match#*"$CCM_TAB"}"; via="bound at $(ccm_tilde "$bound")"; fi
  fi
  if [ -n "$prof" ] && ccm_profile_exists "$prof"; then
    kind="$(ccm_profile_get "$prof" CCM_KIND)"
    cfg="$(ccm_profile_get "$prof" CLAUDE_CONFIG_DIR)"
    proj="$(ccm_profile_get "$prof" ANTHROPIC_VERTEX_PROJECT_ID)"
    region="$(ccm_profile_get "$prof" CLOUD_ML_REGION)"
  elif [ -n "$prof" ]; then
    exists=0
  fi

  # Repository settings that could override the profile.
  root="$( (cd "$dir" && git rev-parse --show-toplevel 2>/dev/null) || true)"
  [ -n "$root" ] || root="$dir"
  for sf in "$root/.claude/settings.json" "$root/.claude/settings.local.json"; do
    [ -f "$sf" ] || continue
    if grep -Eq '"(CLAUDE_CONFIG_DIR|CLAUDE_CODE_USE_[A-Z]+|ANTHROPIC_(API_KEY|AUTH_TOKEN|BASE_URL|VERTEX_PROJECT_ID)|CLOUD_ML_REGION|GOOGLE_CLOUD_PROJECT)"' "$sf"; then
      warns="$warns$sf"$'\n'
    fi
  done

  if [ $json = 1 ]; then
    printf '{"dir":%s,"profile":%s,"exists":%s,"source":%s,"boundPath":%s,"kind":%s,"configDir":%s,"vertexProject":%s,"region":%s,"conflictingSettings":[' \
      "$(jstr "$dir")" "$(jstr "$prof")" "$([ $exists = 1 ] && echo true || echo false)" "$(jstr "$src")" \
      "$(jstr "$bound")" "$(jstr "$kind")" "$(jstr "$cfg")" "$(jstr "$proj")" "$(jstr "$region")"
    local first=1 w
    while IFS= read -r w; do
      [ -n "$w" ] || continue
      [ $first = 1 ] || printf ','; first=0
      jstr "$w"
    done <<EOF
$warns
EOF
    printf ']}\n'
    return 0
  fi

  echo "Directory:   $(ccm_tilde "$dir")"
  if [ -z "$prof" ]; then
    echo "Profile:     none — claude will refuse to start here (use: ccm bind <profile>)"
    return 1
  fi
  if [ $exists = 0 ]; then
    echo "Profile:     $prof — WARNING: this profile does not exist"
    return 1
  fi
  echo "Profile:     $prof ($kind), $via"
  echo "Config dir:  $(ccm_tilde "$cfg")"
  [ "$kind" != vertex ] || echo "GCP project: $proj  region: $region"
  while IFS= read -r w; do
    [ -n "$w" ] && echo "WARNING: $(ccm_tilde "$w") sets account/provider variables that can override the profile"
  done <<EOF
$warns
EOF
  return 0
}

cmd_current() {
  local dir match prof
  dir="$(ccm_realdir "${1:-.}")"; [ -n "$dir" ] || ccm_die "no such directory: ${1:-.}"
  if [ -n "${CCM_OVERRIDE:-}" ]; then
    prof="$CCM_OVERRIDE"
  else
    match="$(ccm_resolve "$dir")"
    prof="${match%%"$CCM_TAB"*}"
  fi
  [ -n "$prof" ] || return 1
  printf '%s\n' "$prof"
}

cmd_list_json() {
  local n first=1 p prof
  printf '{"version":%s,"shim":%s,"home":%s,"profiles":[' "$(jstr "$CCM_VERSION")" "$(jstr "$CCM_ROOT/shims/claude")" "$(jstr "$CCM_HOME")"
  for n in $(ccm_profile_names); do
    [ $first = 1 ] || printf ','; first=0
    printf '{"name":%s,"kind":%s,"configDir":%s,"vertexProject":%s}' "$(jstr "$n")" \
      "$(jstr "$(ccm_profile_get "$n" CCM_KIND)")" "$(jstr "$(ccm_profile_get "$n" CLAUDE_CONFIG_DIR)")" \
      "$(jstr "$(ccm_profile_get "$n" ANTHROPIC_VERTEX_PROJECT_ID)")"
  done
  printf '],"bindings":['
  first=1
  if [ -f "$CCM_PROJECTS_FILE" ]; then
    while IFS=$'\t' read -r p prof || [ -n "$p" ]; do
      case "$p" in ''|'#'*) continue ;; esac
      [ $first = 1 ] || printf ','; first=0
      printf '{"path":%s,"profile":%s,"profileExists":%s}' "$(jstr "$p")" "$(jstr "$prof")" \
        "$(ccm_profile_exists "$prof" && echo true || echo false)"
    done < "$CCM_PROJECTS_FILE"
  fi
  printf ']}\n'
}

cmd_list() {
  if [ "${1:-}" = --json ]; then cmd_list_json; return; fi
  local n kind dir extra p prof
  echo "Profiles:"
  if [ -z "$(ccm_profile_names)" ]; then echo "  (none — create the first one with: ccm add <name>)"; fi
  for n in $(ccm_profile_names); do
    kind="$(ccm_profile_get "$n" CCM_KIND)"
    dir="$(ccm_tilde "$(ccm_profile_get "$n" CLAUDE_CONFIG_DIR)")"
    extra=""
    [ "$kind" != vertex ] || extra="project: $(ccm_profile_get "$n" ANTHROPIC_VERTEX_PROJECT_ID)"
    printf '  %-14s %-9s %s  %s\n' "$n" "$kind" "$dir" "$extra"
  done
  echo "Projects:"
  if [ ! -s "$CCM_PROJECTS_FILE" ] || ! grep -qv '^#' "$CCM_PROJECTS_FILE"; then
    echo "  (none — bind one with: cd <project> && ccm bind <profile>)"; return 0
  fi
  while IFS=$'\t' read -r p prof || [ -n "$p" ]; do
    case "$p" in ''|'#'*) continue ;; esac
    if ccm_profile_exists "$prof"; then extra=""; else extra="  (missing profile!)"; fi
    printf '  %-40s → %s%s\n' "$(ccm_tilde "$p")" "$prof" "$extra"
  done < "$CCM_PROJECTS_FILE"
}

cmd_run() {
  need_profile "${1:-}"
  local prof="$1"; shift
  CCM_OVERRIDE="$prof" exec "$CCM_ROOT/shims/claude" ${1+"$@"}
}

cmd_statusline() {
  [ -t 0 ] || cat >/dev/null   # Claude Code sends JSON on stdin: not needed
  local out="ccm: ${CCM_PROFILE:-?}"
  [ "${CCM_KIND:-}" != vertex ] || out="$out · vertex ${ANTHROPIC_VERTEX_PROJECT_ID:-}"
  [ "${CCM_KIND:-}" != personal ] || out="$out · PERSONAL"
  printf '%s\n' "$out"
}

cmd_doctor() {
  local ok=0 real v n kind dir p prof cfg
  echo "ccm $CCM_VERSION in $(ccm_tilde "$CCM_ROOT")"
  if [ "$(command -v claude 2>/dev/null || true)" = "$CCM_ROOT/shims/claude" ]; then
    echo "✓ the ccm shim is the first 'claude' on PATH"
  else
    echo "✗ the first 'claude' on PATH is $(command -v claude 2>/dev/null || echo 'none'): the ccm block must be the LAST thing in your rc file"; ok=1
  fi
  if real="$(ccm_real_claude)"; then
    echo "✓ real claude: $(ccm_tilde "$real") ($("$real" --version 2>/dev/null | head -n1 || echo 'unknown version'))"
  else
    echo "✗ real claude not found on PATH"; ok=1
  fi
  for v in $CCM_MANAGED_VARS; do
    case "$v" in CCM_*) continue ;; esac
    if [ -n "${!v:-}" ]; then echo "! $v is set in your shell: the shim ignores it, but check that nothing else relies on it"; fi
  done
  for n in $(ccm_profile_names); do
    kind="$(ccm_profile_get "$n" CCM_KIND)"; dir="$(ccm_profile_get "$n" CLAUDE_CONFIG_DIR)"
    if [ ! -d "$dir" ]; then echo "✗ [$n] missing config dir: $(ccm_tilde "$dir")"; ok=1; continue; fi
    if [ "$kind" = vertex ]; then
      cfg="$(ccm_profile_get "$n" CLOUDSDK_ACTIVE_CONFIG_NAME)"
      if ! command -v gcloud >/dev/null; then echo "✗ [$n] gcloud is not installed"; ok=1
      elif CLOUDSDK_ACTIVE_CONFIG_NAME="${cfg:-${CLOUDSDK_ACTIVE_CONFIG_NAME:-}}" gcloud auth application-default print-access-token >/dev/null 2>&1; then
        echo "✓ [$n] ADC credentials are valid"
      else echo "✗ [$n] ADC credentials missing or expired: ccm login $n"; ok=1; fi
    elif [ -f "$dir/.credentials.json" ] || grep -qs '"oauthAccount"' "$dir/.claude.json"; then
      echo "✓ [$n] login found"
    else
      echo "? [$n] login not detected (on macOS credentials live in the Keychain: check with /status, or run: ccm login $n)"
    fi
  done
  if [ -f "$CCM_PROJECTS_FILE" ]; then
    while IFS=$'\t' read -r p prof || [ -n "$p" ]; do
      case "$p" in ''|'#'*) continue ;; esac
      ccm_profile_exists "$prof" || { echo "✗ $(ccm_tilde "$p") → '$prof' (missing profile)"; ok=1; }
      [ -d "$p" ] || echo "! $(ccm_tilde "$p") no longer exists (remove it with: ccm unbind \"$p\")"
    done < "$CCM_PROJECTS_FILE"
  fi
  return $ok
}

cmd_init() {
  cat <<EOF
export PATH="$CCM_ROOT/shims:$CCM_ROOT/bin:\$PATH"
_ccm_complete() {
  local cur="\${COMP_WORDS[COMP_CWORD]}" prev="\${COMP_WORDS[1]:-}"
  if [ "\$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=(\$(compgen -W "add login rename edit remove bind unbind which current list run doctor init version help" -- "\$cur"))
  elif [ "\$COMP_CWORD" -eq 2 ]; then
    case "\$prev" in
      login|rename|edit|remove|bind|run) COMPREPLY=(\$(compgen -W "\$(ls "$CCM_PROFILES_DIR" 2>/dev/null | sed 's/\\.env\$//')" -- "\$cur")) ;;
      unbind|which|current) COMPREPLY=(\$(compgen -d -- "\$cur")) ;;
    esac
  fi
}
if [ -n "\${ZSH_VERSION:-}" ]; then
  autoload -U +X compinit 2>/dev/null && { whence compdef >/dev/null || compinit -u; }
  autoload -U +X bashcompinit 2>/dev/null && bashcompinit
fi
command -v complete >/dev/null 2>&1 && complete -F _ccm_complete ccm
EOF
}

cmd_edit() { need_profile "${1:-}"; "${EDITOR:-vi}" "$(ccm_profile_file "$1")"; }

cmd_remove() {
  need_profile "${1:-}"
  local dir; dir="$(ccm_profile_get "$1" CLAUDE_CONFIG_DIR)"
  rm -f "$(ccm_profile_file "$1")"
  if [ -f "$CCM_PROJECTS_FILE" ]; then
    P="$1" awk -F'\t' '$2 != ENVIRON["P"]' "$CCM_PROJECTS_FILE" > "$CCM_PROJECTS_FILE.tmp.$$"
    mv "$CCM_PROJECTS_FILE.tmp.$$" "$CCM_PROJECTS_FILE"
  fi
  echo "✓ profile '$1' and its bindings removed"
  echo "  its config dir (credentials and conversations) is still in $(ccm_tilde "$dir"): delete it by hand if you no longer need it"
}

cmd="${1:-help}"; [ $# -eq 0 ] || shift
case "$cmd" in
  add) cmd_add ${1+"$@"} ;;
  login) cmd_login ${1+"$@"} ;;
  rename|mv) cmd_rename ${1+"$@"} ;;
  edit) cmd_edit ${1+"$@"} ;;
  remove|rm) cmd_remove ${1+"$@"} ;;
  bind) cmd_bind ${1+"$@"} ;;
  unbind) cmd_unbind ${1+"$@"} ;;
  which) cmd_which ${1+"$@"} ;;
  current) cmd_current ${1+"$@"} ;;
  list|ls) cmd_list ${1+"$@"} ;;
  run) cmd_run ${1+"$@"} ;;
  doctor) cmd_doctor ;;
  statusline) cmd_statusline ;;
  init) cmd_init ;;
  version|--version|-v) echo "ccm $CCM_VERSION" ;;
  help|--help|-h) usage ;;
  *) ccm_warn "unknown command: $cmd"; usage >&2; exit 1 ;;
esac
